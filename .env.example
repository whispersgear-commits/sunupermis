# Projet Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx

# Adresse publique du site (liens d'invitation, retours de paiement)
NEXT_PUBLIC_SITE_URL=https://sunupermis.netlify.app

# Clé de service Supabase : SECRÈTE, uniquement côté serveur.
# Utilisée par la tâche des rappels du soir.
SUPABASE_SERVICE_ROLE_KEY=

# Paiement de l'abonnement par Bictorys (voir docs/PAIEMENT.md)
BICTORYS_API_KEY=
BICTORYS_WEBHOOK_SECRET=
# « live » en production ; absent = bac à sable
BICTORYS_MODE=
# Secret du serveur ; son empreinte SHA-256 est dans la table app_secrets
PAYMENTS_SERVER_SECRET=

# WhatsApp Cloud API (voir docs/WHATSAPP.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Facultatif : noms et langue des modèles
# WHATSAPP_TEMPLATE_LESSON=rappel_lecon
# WHATSAPP_TEMPLATE_PAYMENT=rappel_paiement
# WHATSAPP_TEMPLATE_LANGUAGE=fr

# Secret partagé entre la tâche planifiée Netlify et /api/cron/rappels
CRON_SECRET=

# Numéro WhatsApp du support, affiché quand Bictorys n'est pas configuré
SUPPORT_WHATSAPP=221782932433
